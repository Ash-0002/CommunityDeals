# Server
APP_ENV=development
APP_PORT=8080
APP_NAME=community-platform

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=community_platform
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=12345
JWT_REFRESH_SECRET=12345
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
# Set to true in development to use a fixed OTP (111111) without SMS
OTP_DEV_MODE=true

# SMS Provider (Twilio / MSG91 / etc.)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Rate Limiting
RATE_LIMIT_OTP_PER_PHONE=5
RATE_LIMIT_OTP_WINDOW=1h
